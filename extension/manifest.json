{
  "manifest_version": 3,
  "name": "Job Search Companion",
  "version": "0.15.1",
  "description": "Track and browse jobs, check loaded Indeed descriptions for blockers using ChatGPT plan usage, and analyse CV fit with Codex.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:48973/*",
    "https://indeed.com/*",
    "https://*.indeed.com/*",
    "https://indeed.co.uk/*",
    "https://*.indeed.co.uk/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://indeed.com/*",
        "https://*.indeed.com/*",
        "https://indeed.co.uk/*",
        "https://*.indeed.co.uk/*"
      ],
      "js": [
        "indeed-layout.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://indeed.com/*",
        "https://*.indeed.com/*",
        "https://indeed.co.uk/*",
        "https://*.indeed.co.uk/*"
      ],
      "js": [
        "indeed-description-capture.bundle.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://indeed.com/*",
        "https://*.indeed.com/*",
        "https://indeed.co.uk/*",
        "https://*.indeed.co.uk/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "contracts/job-urls.js",
        "contracts/job-storage-keys.js",
        "contracts/job-marks.js",
        "contracts/identifiers.js",
        "contracts/job-analyses.js",
        "contracts/messages.js",
        "contracts/cv-fit-submissions.js",
        "contracts/cv-fit-settings.js",
        "contracts/shortcuts.js",
        "extension-context.js",
        "dom-visibility.js",
        "job-url.js",
        "job-resolution.js",
        "job-navigation.js",
        "feedback.js",
        "cv-fit-submission.js",
        "storage-observer.js",
        "job-mark-store.js",
        "page-decorations.js",
        "job-marks.js",
        "job-analysis-store.js",
        "job-analyses.js",
        "shortcuts.js",
        "job-menu.js",
        "job-menu-observer.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://indeed.com/*",
        "https://*.indeed.com/*",
        "https://indeed.co.uk/*",
        "https://*.indeed.co.uk/*"
      ],
      "js": [
        "contracts/indeed-availability.js",
        "contracts/indeed-to-apply.js",
        "contracts/blockers.js",
        "contracts/inference-settings.js",
        "blockers/client.js",
        "indeed-job-metadata.js",
        "indeed-to-apply-renderer.js",
        "indeed-to-apply.js",
        "blockers/indeed-description-store.js",
        "blockers/result-store.js",
        "blockers/renderer.js",
        "blockers/checker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "suggestion-card.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Job Search Companion settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
