{
  "manifest_version": 3,
  "name": "Job Search Companion",
  "version": "0.11.0",
  "description": "Track applied jobs, browse Indeed and LinkedIn, and analyse CV fit with Codex.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:48973/*",
    "https://indeed.com/*",
    "https://*.indeed.com/*",
    "https://indeed.co.uk/*",
    "https://*.indeed.co.uk/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://indeed.com/*",
        "https://*.indeed.com/*",
        "https://indeed.co.uk/*",
        "https://*.indeed.co.uk/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "extension-context.js",
        "dom-visibility.js",
        "job-url.js",
        "job-resolution.js",
        "job-navigation.js",
        "submission.js",
        "applied-jobs.js",
        "shortcuts.js",
        "share-menu.js",
        "share-menu-observer.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
