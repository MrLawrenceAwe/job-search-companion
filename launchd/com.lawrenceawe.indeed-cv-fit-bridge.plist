<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lawrenceawe.indeed-cv-fit-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>__INDEED_CV_FIT_BRIDGE_ROOT__/bridge/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INDEED_CV_FIT_BRIDGE_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>INDEED_CV_FIT_WORKSPACE</key>
    <string>__INDEED_CV_FIT_WORKSPACE__</string>
    <key>INDEED_CV_FIT_LOG_PATH</key>
    <string>__INDEED_CV_FIT_LOG_PATH__</string>
    <key>INDEED_CV_FIT_BRIDGE_TOKEN</key>
    <string>__INDEED_CV_FIT_BRIDGE_TOKEN__</string>
    <key>INDEED_CV_FIT_EXTENSION_ORIGIN</key>
    <string>__INDEED_CV_FIT_EXTENSION_ORIGIN__</string>
    <key>INDEED_CV_FIT_BRIDGE_INSTANCE_ID</key>
    <string>__INDEED_CV_FIT_BRIDGE_INSTANCE_ID__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/dev/null</string>

  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
